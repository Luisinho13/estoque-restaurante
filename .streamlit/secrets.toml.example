# Copie este arquivo para .streamlit/secrets.toml e preencha a URL real.
# O secrets.toml está no .gitignore e nunca deve ser commitado.
#
# Na nuvem, o mesmo conteúdo vai no painel de Secrets do app,
# em Settings > Secrets, em vez de num arquivo.

[postgres]
url = "postgresql://usuario:senha@host/banco?sslmode=require"
